# Copy to fastlane/.env and fill in — fastlane loads it automatically.
# Never commit the real .env; commit only this template.

# Release (upload) keystore — read by Godot itself during release exports.
GODOT_ANDROID_KEYSTORE_RELEASE_PATH=~/keystores/upload.keystore
GODOT_ANDROID_KEYSTORE_RELEASE_USER=upload
GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD=change-me

# Google Play service-account JSON key for uploads.
PLAY_JSON_KEY_PATH=~/keystores/play-service-account.json
